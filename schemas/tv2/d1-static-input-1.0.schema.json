{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tv2-d1-static-input/1.0",
  "title": "Proposed static input record for D1 (not agreed by the group)",
  "type": "object",
  "required": ["schema", "sha256", "analysis_id", "features_content_sha256", "analysis_status", "values", "missing"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "tv2-d1-static-input/1.0"},
    "sha256": {"type": ["string", "null"], "pattern": "^[0-9A-F]{64}$"},
    "analysis_id": {"type": "string"},
    "features_content_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "analysis_status": {"enum": ["ok", "partial", "error", "unsupported"]},
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imports_get_proc_address", "hash_like_loops", "non_import_indirect_calls",
                   "get_proc_address_calls", "dynamic_name_calls", "export_names_enumerated",
                   "export_name_to_hash", "hash_to_compare", "compare_to_name_selection",
                   "selection_to_resolve", "resolve_to_pointer_use"],
      "properties": {
        "imports_get_proc_address": {"type": ["integer", "null"], "minimum": 0},
        "hash_like_loops": {"type": ["integer", "null"], "minimum": 0},
        "non_import_indirect_calls": {"type": ["integer", "null"], "minimum": 0},
        "get_proc_address_calls": {"type": ["integer", "null"], "minimum": 0},
        "dynamic_name_calls": {"type": ["integer", "null"], "minimum": 0},
        "export_names_enumerated": {"enum": [0.0, 0.5, 1.0, null]},
        "export_name_to_hash": {"enum": [0.0, 0.5, 1.0, null]},
        "hash_to_compare": {"enum": [0.0, 0.5, 1.0, null]},
        "compare_to_name_selection": {"enum": [0.0, 0.5, 1.0, null]},
        "selection_to_resolve": {"enum": [0.0, 0.5, 1.0, null]},
        "resolve_to_pointer_use": {"enum": [0.0, 0.5, 1.0, null]}
      }
    },
    "missing": {"type": "array", "items": {"type": "string"}}
  }
}
